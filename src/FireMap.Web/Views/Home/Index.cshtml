@{
    ViewData["Title"] = "Hot Spot Explorer";
}

<div class="app">
    <aside class="sidebar" id="sidebar" aria-label="Controls">
        <header class="brand">
            <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2c.6 3.2-1.2 5-2.7 6.6C7.7 10.3 6 12.1 6 15a6 6 0 0 0 12 0c0-2.4-1.1-4-2.3-5.3-.3 1.6-1.1 2.6-2.2 3 .4-3.6-.4-7.4-1.5-10.7Z" />
            </svg>
            <div>
                <h1>Hot Spot Explorer</h1>
                <p class="subtitle">MODIS · VIIRS · Harmonized</p>
            </div>
            <button class="icon-btn sidebar-close" id="sidebar-close" type="button" aria-label="Hide panel">&times;</button>
        </header>

        <div class="sidebar-scroll">
            <section class="panel">
                <h2>Time range <span class="muted">(UTC)</span></h2>
                <div class="chips" id="range-presets" role="group" aria-label="Quick ranges">
                    <button type="button" class="chip" data-days="1">Today</button>
                    <button type="button" class="chip" data-days="2">2 days</button>
                    <button type="button" class="chip" data-days="7">7 days</button>
                    <button type="button" class="chip" data-days="30">30 days</button>
                </div>
                <div class="period-label" id="period-a-label" hidden>
                    <span class="dot" style="--c:var(--period-a)"></span>Period A
                </div>
                <div class="date-row" id="date-row-a">
                    <label>From <input type="date" id="date-from" required /></label>
                    <label>To <input type="date" id="date-to" required /></label>
                </div>

                <div class="period-b" id="period-b" hidden>
                    <div class="period-label">
                        <span class="dot" style="--c:var(--period-b)"></span>Period B
                        <span class="muted small">compare with</span>
                    </div>
                    <div class="chips" id="compare-presets" role="group" aria-label="Same dates in an earlier year">
                        <button type="button" class="chip" data-years="1">−1 year</button>
                        <button type="button" class="chip" data-years="2">−2 years</button>
                        <button type="button" class="chip" data-years="5">−5 years</button>
                    </div>
                    <div class="date-row" id="date-row-b">
                        <label>From <input type="date" id="cmp-from" /></label>
                        <label>To <input type="date" id="cmp-to" /></label>
                    </div>
                </div>
                <div class="range-footer">
                    <p class="hint" id="range-hint" aria-live="polite"></p>
                    <div class="range-actions">
                        <button type="button" class="link-btn" id="range-cancel" hidden>Cancel</button>
                        <button type="button" class="btn-primary" id="range-apply" disabled>Apply</button>
                    </div>
                </div>
                <div class="range-extras">
                    <button type="button" class="tool compare-btn" id="compare-toggle" aria-pressed="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4 3 8l4 4M3 8h13M17 12l4 4-4 4M21 16H8" /></svg>
                        Compare periods
                    </button>
                    <label class="switch-row">
                        <input type="checkbox" id="play-toggle" role="switch" />
                        <span class="switch" aria-hidden="true"></span>
                        <span>Play timeline</span>
                    </label>
                </div>
            </section>

            <section class="panel">
                <h2>Layers</h2>
                <ul class="layer-list" id="layer-list"></ul>
            </section>

            <section class="panel">
                <h2>Analyze an area</h2>
                <div class="tool-row">
                    <button type="button" class="tool" id="tool-rect" aria-pressed="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="12" rx="1.5" /></svg>
                        Draw rectangle
                    </button>
                    <button type="button" class="tool" id="tool-country" aria-pressed="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4v16M5 5h11l-2 3.5L16 12H5" /></svg>
                        Pick country
                    </button>
                </div>
                <div class="search-row">
                    <input type="search" id="country-search" list="country-names" placeholder="…or type a country name" autocomplete="off" />
                    <datalist id="country-names"></datalist>
                </div>
                <p class="hint" id="tool-hint"></p>
            </section>

            <section class="panel stats-panel" id="stats-panel" hidden>
                <div class="stats-title">
                    <h2>Statistics</h2>
                    <button type="button" class="link-btn" id="tool-clear">Clear</button>
                </div>
                <div id="stats" aria-live="polite"></div>
            </section>
        </div>

        <footer class="sidebar-footer">
            <span id="quota" title="NASA FIRMS transactions in the last 10 minutes">NASA quota: –</span>
            <span class="badge" id="mode-badge" hidden>Sample data</span>
        </footer>
    </aside>

    <main class="map-wrap">
        <div id="map" role="application" aria-label="Fire hot spot map"></div>
        <button class="icon-btn sidebar-open" id="sidebar-open" type="button" aria-label="Show panel">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
        <div class="timeline" id="timeline" role="group" aria-label="Timeline" hidden>
            <div class="tl-buttons">
                <button type="button" class="tl-btn" id="tl-prev" aria-label="Previous day">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h2v14H6zM19 5v14L9 12z" /></svg>
                </button>
                <button type="button" class="tl-btn tl-play" id="tl-play" aria-label="Play"></button>
                <button type="button" class="tl-btn" id="tl-next" aria-label="Next day">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 5h2v14h-2zM5 5v14l10-7z" /></svg>
                </button>
            </div>
            <div class="tl-track">
                <div class="tl-bars" id="tl-bars"></div>
                <input type="range" id="tl-slider" min="0" max="0" step="1" value="0" aria-label="Day" />
                <div class="tl-axis"><span id="tl-start"></span><span id="tl-end"></span></div>
            </div>
            <div class="tl-info">
                <div class="tl-date" id="tl-date"></div>
                <div class="tl-count" id="tl-count"></div>
                <label class="tl-speed">Speed
                    <select id="tl-speed">
                        <option value="500">0.5 s</option>
                        <option value="1000" selected>1 s</option>
                        <option value="2000">2 s</option>
                    </select>
                </label>
            </div>
        </div>
        <div class="map-status">
            <div class="pill loading" id="loading" hidden><span class="spinner"></span><span id="loading-text">Loading…</span></div>
            <div class="pill banner" id="banner" hidden></div>
        </div>
    </main>
</div>

@section Scripts {
    <script type="module" src="~/js/app.js" asp-append-version="true"></script>
}
